# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID of the private, topics-enabled Telegram storage group (usually starts with -100)
TELEGRAM_STORAGE_CHANNEL=-1001234567890

# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional paths; keep these under a persistent data directory in deployments
SESSION_STORAGE_PATH=data/sessions.json
TOPIC_INDEX_PATH=data/topics.json
